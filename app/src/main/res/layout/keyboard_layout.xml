<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keyboard_root_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/keyboard_main_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/keyboard_bg">

        <!-- Top Telemetry & Control Toolbar -->
        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:background="@color/keyboard_bar_bg">

            <View
                android:id="@+id/status_indicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/status_dot"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALLOW"
                android:textColor="@color/risk_allow"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/score_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textColor="@color/key_text_hint"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/enrollment_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/lavender_blue"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="6dp" />

            <!-- Long-Press Mode Toggle (VAR / REP) -->
            <TextView
                android:id="@+id/btn_mode_toggle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="VAR"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/lavender_blue"
                android:fontFamily="sans-serif-medium"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle Long-Press Mode (Variants or Rapid-Fire)" />

            <!-- Resize Keyboard Toggle Button -->
            <ImageView
                android:id="@+id/btn_resize_toggle"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:src="@drawable/ic_resize"
                android:contentDescription="Resize keyboard"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:tint="@color/key_text_special" />

            <!-- Keyboard Dismiss Button (Reference layout positioning) -->
            <ImageView
                android:id="@+id/btn_keyboard_dismiss"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:src="@drawable/ic_keyboard_hide"
                android:contentDescription="Hide keyboard"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:tint="@color/key_text_special" />
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/key_border" />

        <!-- Resize Control Panel -->
        <LinearLayout
            android:id="@+id/resize_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@color/keyboard_bar_bg"
            android:paddingTop="5dp"
            android:paddingBottom="7dp"
            android:paddingHorizontal="10dp">

            <!-- Drag Handle Area -->
            <LinearLayout
                android:id="@+id/resize_drag_handle_area"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/resize_handle_bg">

                <View
                    android:layout_width="48dp"
                    android:layout_height="4dp"
                    android:background="@drawable/drag_handle_pill"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tv_resize_height_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↕ Drag to resize: 280 dp"
                    android:textColor="@color/key_text_special"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Preset Buttons & Actions Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/btn_size_compact"
                    style="@style/ResizePresetButton"
                    android:text="210" />

                <TextView
                    android:id="@+id/btn_size_short"
                    style="@style/ResizePresetButton"
                    android:text="245" />

                <TextView
                    android:id="@+id/btn_size_normal"
                    style="@style/ResizePresetButton"
                    android:text="280" />

                <TextView
                    android:id="@+id/btn_size_tall"
                    style="@style/ResizePresetButton"
                    android:text="320" />

                <TextView
                    android:id="@+id/btn_size_xtall"
                    style="@style/ResizePresetButton"
                    android:text="360" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btn_resize_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Reset"
                    android:textColor="@color/key_text_special"
                    android:textSize="12sp"
                    android:background="@drawable/resize_chip_bg"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btn_resize_done"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Done ✓"
                    android:textColor="@color/key_accent_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/resize_chip_done_bg" />
            </LinearLayout>
        </LinearLayout>

        <!-- Keyboard rows container (Responsive layout with reference key arrangement) -->
        <LinearLayout
            android:id="@+id/keyboard_rows_container"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:orientation="vertical"
            android:paddingHorizontal="3dp"
            android:paddingBottom="6dp"
            android:paddingTop="5dp">

            <!-- Row 1: QWERTYUIOP (10 keys with secondary number hints 1..0) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="3dp">

                <TextView android:id="@+id/key_q" style="@style/KeyStyle.Normal" android:text="q"/>
                <TextView android:id="@+id/key_w" style="@style/KeyStyle.Normal" android:text="w"/>
                <TextView android:id="@+id/key_e" style="@style/KeyStyle.Normal" android:text="e"/>
                <TextView android:id="@+id/key_r" style="@style/KeyStyle.Normal" android:text="r"/>
                <TextView android:id="@+id/key_t" style="@style/KeyStyle.Normal" android:text="t"/>
                <TextView android:id="@+id/key_y" style="@style/KeyStyle.Normal" android:text="y"/>
                <TextView android:id="@+id/key_u" style="@style/KeyStyle.Normal" android:text="u"/>
                <TextView android:id="@+id/key_i" style="@style/KeyStyle.Normal" android:text="i"/>
                <TextView android:id="@+id/key_o" style="@style/KeyStyle.Normal" android:text="o"/>
                <TextView android:id="@+id/key_p" style="@style/KeyStyle.Normal" android:text="p"/>
            </LinearLayout>

            <!-- Row 2: ASDFGHJKL (9 keys, optical half-key spacers for identical key width as Row 1) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="3dp">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.5" />

                <TextView android:id="@+id/key_a" style="@style/KeyStyle.Normal" android:text="a"/>
                <TextView android:id="@+id/key_s" style="@style/KeyStyle.Normal" android:text="s"/>
                <TextView android:id="@+id/key_d" style="@style/KeyStyle.Normal" android:text="d"/>
                <TextView android:id="@+id/key_f" style="@style/KeyStyle.Normal" android:text="f"/>
                <TextView android:id="@+id/key_g" style="@style/KeyStyle.Normal" android:text="g"/>
                <TextView android:id="@+id/key_h" style="@style/KeyStyle.Normal" android:text="h"/>
                <TextView android:id="@+id/key_j" style="@style/KeyStyle.Normal" android:text="j"/>
                <TextView android:id="@+id/key_k" style="@style/KeyStyle.Normal" android:text="k"/>
                <TextView android:id="@+id/key_l" style="@style/KeyStyle.Normal" android:text="l"/>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.5" />
            </LinearLayout>

            <!-- Row 3: SHIFT + ZXCVBNM + DEL (All 7 letters weight 1.0, Shift and Delete weight 1.5) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="3dp">

                <TextView android:id="@+id/key_shift" style="@style/KeyStyle.Special" android:layout_weight="1.5" android:text="⇧"/>
                <TextView android:id="@+id/key_z" style="@style/KeyStyle.Normal" android:text="z"/>
                <TextView android:id="@+id/key_x" style="@style/KeyStyle.Normal" android:text="x"/>
                <TextView android:id="@+id/key_c" style="@style/KeyStyle.Normal" android:text="c"/>
                <TextView android:id="@+id/key_v" style="@style/KeyStyle.Normal" android:text="v"/>
                <TextView android:id="@+id/key_b" style="@style/KeyStyle.Normal" android:text="b"/>
                <TextView android:id="@+id/key_n" style="@style/KeyStyle.Normal" android:text="n"/>
                <TextView android:id="@+id/key_m" style="@style/KeyStyle.Normal" android:text="m"/>
                <TextView android:id="@+id/key_delete" style="@style/KeyStyle.Special" android:layout_weight="1.5" android:text="⌫"/>
            </LinearLayout>

            <!-- Row 4: ?123 + #+= + , + SPACE + . + 🌐 + RETURN (7-key layout from reference) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/key_symbols"
                    style="@style/KeyStyle.Special"
                    android:layout_weight="1.2"
                    android:textSize="13sp"
                    android:text="SYM"/>

                <TextView
                    android:id="@+id/key_numpad"
                    style="@style/KeyStyle.Special"
                    android:layout_weight="1.1"
                    android:textSize="13sp"
                    android:text="123"/>

                <TextView
                    android:id="@+id/key_comma"
                    style="@style/KeyStyle.Normal"
                    android:layout_weight="1.0"
                    android:text=","/>

                <TextView
                    android:id="@+id/key_space"
                    style="@style/KeyStyle.Space"
                    android:layout_weight="3.4"
                    android:text="space"/>

                <TextView
                    android:id="@+id/key_period"
                    style="@style/KeyStyle.Normal"
                    android:layout_weight="1.0"
                    android:text="."/>

                <TextView
                    android:id="@+id/key_switch"
                    style="@style/KeyStyle.Special"
                    android:layout_weight="1.1"
                    android:textSize="14sp"
                    android:text="🌐"/>

                <TextView
                    android:id="@+id/key_enter"
                    style="@style/KeyStyle.Accent"
                    android:layout_weight="1.2"
                    android:textSize="16sp"
                    android:text="↵"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Character Variants Popup & Key Preview Bubble Overlay -->
    <FrameLayout
        android:id="@+id/keyboard_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone">

        <!-- Floating Key Preview Bubble (pops up above the touched key) -->
        <FrameLayout
            android:id="@+id/key_preview_bubble"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:visibility="gone"
            android:elevation="18dp"
            android:background="@drawable/key_preview_bubble_bg">

            <TextView
                android:id="@+id/tv_preview_char"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/key_text"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />
        </FrameLayout>

        <!-- Floating Character Variants Popup Card -->
        <LinearLayout
            android:id="@+id/variants_popup_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/popup_variants_background"
            android:elevation="20dp"
            android:padding="3dp" />
    </FrameLayout>
</FrameLayout>
