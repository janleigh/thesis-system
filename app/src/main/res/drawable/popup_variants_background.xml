<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft bottom drop shadow layer -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/key_shadow" />
        </shape>
    </item>
    <!-- Main white card surface with iOS borders and radius -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/key_bg_normal" />
            <stroke android:width="0.75dp" android:color="@color/key_border" />
            <padding
                android:left="5dp"
                android:top="4dp"
                android:right="5dp"
                android:bottom="4dp" />
        </shape>
    </item>
</layer-list>
