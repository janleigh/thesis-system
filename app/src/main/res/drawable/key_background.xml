<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/key_ripple">
    <item>
        <selector>
            <!-- Pressed state: keycap depresses down by 1.5dp -->
            <item android:state_pressed="true">
                <layer-list>
                    <item android:top="1.5dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="7dp" />
                            <solid android:color="@color/key_bg_pressed" />
                            <stroke android:width="0.75dp" android:color="@color/key_border" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <!-- Normal state: elevated white keycap with soft shadow beneath -->
            <item>
                <layer-list>
                    <!-- Bottom soft shadow layer -->
                    <item android:top="1.5dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="7dp" />
                            <solid android:color="@color/key_shadow" />
                        </shape>
                    </item>
                    <!-- Main white rounded square surface -->
                    <item android:bottom="1.5dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="7dp" />
                            <solid android:color="@color/key_bg_normal" />
                            <stroke android:width="0.75dp" android:color="@color/key_border" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
